# ====================================================================
# MEDILENS AI — ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Copy this file to '.env' and fill in your local system credentials.
# NEVER commit your real '.env' file containing secrets to GitHub.
# ====================================================================

# 1. Flask Security
SECRET_KEY=medilens_ai_production_grade_random_secret_key_32_bytes_min

# 2. Local MySQL Database Credentials
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=medilens
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_root_password

# 3. AI Vision & Clinical Intelligence APIs
# Primary Multimodal Vision: Google Gemini API (Get from https://aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here

# Dual-AI Clinical Reasoning & Sub-second Pricing: Groq Cloud (Get from https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here

# 4. Geolocation & Licensed Pharmacies
# Google Maps JavaScript & Places API Key (Get from https://console.cloud.google.com)
# Optional: If omitted, platform gracefully defaults to verified national e-pharmacy registries
MAPS_API_KEY=your_google_maps_api_key_here

# 5. Local OCR & PDF Binary Dependencies (Windows Paths)
# Tesseract OCR executable path (Install from UB-Mannheim: https://github.com/UB-Mannheim/tesseract/wiki)
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# Poppler binary Library/bin directory for PDF rendering (Download from: https://github.com/oschwartz10612/poppler-windows/releases)
POPPLER_PATH=C:\poppler\poppler-26.02.0\Library\bin

# 6. Web Server Port (Default: 5000)
PORT=5000
